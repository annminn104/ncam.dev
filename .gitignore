# ---- dependencies ----
# (matches apps/*/node_modules and packages/*/node_modules too)
node_modules/
.pnpm-store/

# ---- build output ----
dist/
dist-ssr/
build/
.output/
# TOONHUB's figurine AVIFs and WebPs, derived by `pnpm assets` from its committed PNGs
apps/toonhub/public/figurines/*.avif
apps/toonhub/public/figurines/*.webp
# Holodex's first-screen gallery art, copied from TCGdex by `pnpm assets`
apps/holodex/public/gallery/*.webp
# apps/chess figures: raw Blender exports and review captures (scripts/build-figures.mjs,
# scripts/capture-presets.mjs); the packed GLBs in public/presets/ are committed
apps/chess/art/.out/
# Lighthouse CI reports (lighthouserc.cjs)
.lighthouseci/

# ---- caches / task runners ----
.turbo/
# superpowers (agent skills) scratch: plan ledgers, briefs, review packages
.superpowers/
# superpowers specs and plans: kept local, out of the repo
docs/superpowers/
# Claude Code worktrees (EnterWorktree in the desktop app / CLI)
.claude/worktrees/
# autoharness plugin state (counters, ledger, staged intents); the skills it
# lands go to .claude/skills/ and are committed or not by hand
.claude/autoharness/
.vite/
.cache/
*.tsbuildinfo
.eslintcache

# ---- vite temp files ----
vite.config.*.timestamp-*
vite.config.*.mjs.timestamp-*
*.local

# ---- test / coverage ----
coverage/

# ---- logs ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- env ----
# `.env` is committed: non-secret defaults (ports / hostnames / remote URLs).
# Local overrides live in `.env.local` (ignored by the `*.local` rule above);
# put any secret-bearing values there or in `.env.*.local`, never in `.env`.
.env.*.local

# ---- editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- OS ----
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
.vinxi/
.nitro/
.tanstack/
.vercel/
.mf/
# Cultivation Chess: Stockfish files copied from node_modules by `pnpm assets`
apps/chess/public/stockfish/
# Mini Store: Blender's editor backups next to the .blend
apps/mini-store/art/**/*.blend1
# Garden Home: the Basis transcoder copied from three, Blender's raw exports and backups,
# personal ?bg= photos (only the example is tracked), Python caches, Playwright output
apps/garden-home/public/basis/
apps/garden-home/public/backgrounds/*
!apps/garden-home/public/backgrounds/example.jpg
apps/garden-home/art/blender/out/
apps/garden-home/art/**/*.blend1
apps/garden-home/art/**/__pycache__/
apps/garden-home/test-results/
apps/garden-home/playwright-report/
