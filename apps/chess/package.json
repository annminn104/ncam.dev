{
  "name": "@ncam/chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cultivation Chess — international chess with cultivation-treasure pieces in 3D arenas (React Three Fiber, Stockfish), packaged as a self-contained React Module Federation remote.",
  "scripts": {
    "assets": "node scripts/copy-stockfish.mjs",
    "predev": "node scripts/copy-stockfish.mjs",
    "prebuild": "node scripts/copy-stockfish.mjs",
    "dev": "vite",
    "build": "vite build --app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "capture:arenas": "node scripts/capture-arenas.mjs"
  },
  "dependencies": {
    "@ncam/logger": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "chess.js": "^1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "^17.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@ncam/mf-remote": "workspace:*",
    "@ncam/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
