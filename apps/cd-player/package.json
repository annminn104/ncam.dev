{
  "name": "@ncam/cd-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CD Player — any Spotify playlist or album on a 3D suitcase CD player, played through Spotify's embed, packaged as a self-contained React Module Federation remote.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art:build": "node art/pipeline/build.mjs",
    "capture:poster": "node scripts/capture-poster.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@ncam/logger": "workspace:*",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@ncam/mf-remote": "workspace:*",
    "@ncam/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "1.2.0",
    "playwright": "1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
