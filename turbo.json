{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", ".env.local", ".nvmrc", "tsconfig*.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "assets": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "assets"],
      "outputs": ["dist/**", ".output/**", ".vinxi/**", ".nitro/**"],
      "env": [
        "*_REMOTE_URL",
        "*_PORT",
        "*_BASE",
        "PORTFOLIO_PORT",
        "STRAPI_*",
        "PUBLIC_URL",
        "SITE_URL",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "dev": {
      "dependsOn": ["assets"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["STRAPI_URL", "STRAPI_PUBLIC_URL"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["STRAPI_URL", "STRAPI_PUBLIC_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#lint": {
      "inputs": [
        "eslint.config.mjs",
        "apps/**/*.{ts,tsx,js,mjs,cjs}",
        "packages/**/*.{ts,tsx,js,mjs,cjs}"
      ]
    },
    "//#format:check": {
      "inputs": [
        ".prettierrc.json",
        ".prettierignore",
        "**/*.{ts,tsx,js,mjs,cjs,json,css,md,yml,yaml,html}"
      ]
    },
    "//#test": {
      "inputs": ["vitest.config.ts", "packages/**/*.{ts,tsx}", "apps/**/*.{ts,tsx,mjs}"]
    }
  }
}
